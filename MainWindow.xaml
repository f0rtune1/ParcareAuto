<Window x:Class="ParcareAuto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ParcareAuto.Controls"
        Title="Administrarea unei parcari auto" Width="1150" Height="850"
        MinWidth="980" MinHeight="700" Background="#F4F6F9"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="240"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Administrarea parcarii auto" FontSize="26"
                       FontWeight="SemiBold" Foreground="#20364D" Margin="0,0,0,16"/>
            <DataGrid x:Name="AutomobileGrid" Grid.Row="1" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                      SelectionUnit="FullRow" SelectionChanged="AutomobileGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Numar de inmatriculare" Binding="{Binding NumarInmatriculare}" Width="*"/>
                    <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="*"/>
                    <DataGridTextColumn Header="Tip" Binding="{Binding Tip}" Width="*"/>
                    <DataGridTextColumn Header="Ore stationare" Binding="{Binding OreStationare}" Width="*"/>
                    <DataGridTextColumn Header="Tarif/ora (lei)" Binding="{Binding TarifOra, StringFormat={}{0:F2}}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Filtrare dupa tip" FontWeight="SemiBold"/>
                    <ComboBox x:Name="TipFiltruCombo" SelectionChanged="TipFiltruCombo_SelectionChanged"/>
                    <ListBox x:Name="AutomobileList" Height="180" DisplayMemberPath="NumarInmatriculare"
                             SelectionChanged="AutomobileList_SelectionChanged"/>
                    <Button x:Name="EliminaButton" Content="Elimina automobilul selectat"
                            Click="EliminaButton_Click" IsEnabled="False"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Informatii despre automobil" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="SelectieMesaj" Text="Selectati un automobil din lista."/>
                    <StackPanel x:Name="DetaliiPanel" Visibility="Collapsed">
                        <TextBlock Text="{Binding NumarInmatriculare, StringFormat=Numar de inmatriculare: {0}}" Margin="0,2"/>
                        <TextBlock Text="{Binding Marca, StringFormat=Marca: {0}}" Margin="0,2"/>
                        <TextBlock Text="{Binding Tip, StringFormat=Tip: {0}}" Margin="0,2"/>
                        <TextBlock Text="{Binding OraIntrare, StringFormat=Ora intrare: {0:dd.MM.yyyy HH:mm}}" Margin="0,2"/>
                        <TextBlock Text="{Binding OreStationare, StringFormat=Ore stationare: {0}}" Margin="0,2"/>
                        <TextBlock Text="{Binding TarifOra, StringFormat=Tarif pe ora: {0:F2} lei}" Margin="0,2"/>
                        <TextBlock Text="{Binding CostParcare, StringFormat=Cost parcare: {0:F2} lei}"
                                   FontWeight="Bold" FontSize="18" Margin="0,8,0,0"/>
                        <controls:ParkingStatusControl x:Name="StatusControl" OreStationare="{Binding OreStationare, Mode=OneWay}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="3" Margin="0,22,0,0">
                <TextBlock Text="Adauga un automobil" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Numar de inmatriculare"/>
                        <TextBox x:Name="NumarText"/>
                        <TextBlock Text="Marca"/>
                        <TextBox x:Name="MarcaText"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tip automobil"/>
                        <ComboBox x:Name="TipNouCombo"/>
                        <TextBlock Text="Ora intrare (zz.ll.aaaa hh:mm)"/>
                        <TextBox x:Name="OraText"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Ore stationare (numar intreg pozitiv)"/>
                        <TextBox x:Name="OreText"/>
                        <TextBlock Text="Tarif pe ora (lei)"/>
                        <TextBox x:Name="TarifText"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="ValidareText" Foreground="#B42318" TextWrapping="Wrap"/>
                <Button Content="Adauga automobil" HorizontalAlignment="Left" Click="AdaugaButton_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
