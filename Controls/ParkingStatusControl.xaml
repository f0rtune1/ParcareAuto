<UserControl x:Class="ParcareAuto.Controls.ParkingStatusControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#E8F0FA" BorderBrush="#AEC9E9" BorderThickness="1"
            CornerRadius="6" Padding="12" Margin="0,12,0,0">
        <StackPanel>
            <TextBlock Text="Statut stationare" Foreground="#42566D"/>
            <TextBlock x:Name="TextStatus" FontSize="17" FontWeight="SemiBold"
                       Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
